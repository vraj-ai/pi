{
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^0.82.0",
    "acorn": "^8.17.0",
    "firecrawl": "^4.30.0",
    "typebox": "^1.3.6",
    "effect": "^4.0.0-beta.99",
    "@effect/platform-node": "^4.0.0-beta.99",
    "@anthropic-ai/claude-agent-sdk": "^0.3.216"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@effect/tsgo": "^0.24.2",
    "@effect/vitest": "^4.0.0-beta.99",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "test": "node --test --experimental-strip-types extensions/*/*.test.ts && node --test scripts/*.test.mjs && npm --prefix extensions/file-search test",
    "check:provenance": "node scripts/check-provenance.mjs",
    "update-upstream": "node scripts/update-upstream.mjs",
    "gates": "npm run check && npm run check:provenance && npm test"
  }
}
